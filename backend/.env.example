# Backend configuration — EXAMPLE
#
# Copy to backend/.env for local development. Never committed.
#
# Runtime is AWS Lambda + Node.js + TypeScript (ADR-015). The backend does not
# exist yet; this file documents what it will require, so the contract is
# settled before the first line is written.
#
# ---------------------------------------------------------------------------
# IN AWS, THIS FILE IS NOT USED AT ALL.
# ---------------------------------------------------------------------------
#
# Lambda receives the NON-SECRET values below as function environment
# variables. Secret VALUES are never Lambda environment variables — Volume 8,
# Chapter 8.4 §2 is explicit that they would be "visible to anyone with read
# access to the function's configuration". Secrets are fetched at runtime from
# AWS Secrets Manager, by ARN, using the execution role.
#
# A secret ARN is not a secret. It is an identifier; possessing it grants
# nothing without IAM permission to read the secret behind it.


# ---------------------------------------------------------------------------
# Non-secret — set as Lambda environment variables in every environment
# ---------------------------------------------------------------------------

# One of: development | staging | production. Selects the entry in
# infrastructure/aws/config/environments.json.
APP_ENV=development

AWS_REGION=ap-south-1

# Chunk storage bucket. Must match environments.json for APP_ENV — never
# built by concatenating a name onto an environment string at a call site.
CHUNK_BUCKET=vump-platform-dev

# Presigned URL lifetime, seconds. See docs/architecture/aws-sdk-integration.md.
PRESIGN_EXPIRY_SECONDS=3600


# ---------------------------------------------------------------------------
# Secret references — ARNs, not values (Volume 8, Chapter 8.4 §2)
# ---------------------------------------------------------------------------

# Firebase Admin SDK service account key, used to verify ID tokens
# (Volume 4, Chapter 4.7 §1). Rotated manually, annually or on suspected
# compromise.
FIREBASE_SERVICE_ACCOUNT_SECRET_ARN=arn:aws:secretsmanager:ap-south-1:000000000000:secret:vump/dev/firebase-service-account-XXXXXX

# Aurora connection credentials. Rotated automatically by Secrets Manager's
# native RDS rotation.
DATABASE_CREDENTIALS_SECRET_ARN=arn:aws:secretsmanager:ap-south-1:000000000000:secret:vump/dev/aurora-credentials-XXXXXX


# ---------------------------------------------------------------------------
# Local development only — never set in AWS
# ---------------------------------------------------------------------------

# Credentials come from the default AWS provider chain, exactly as they do in
# Lambda. Name a CLI profile; never paste an access key.
#
# There is no AWS_ACCESS_KEY_ID or AWS_SECRET_ACCESS_KEY in this file, and
# there must never be one. If a task seems to need them, it needs a profile.
AWS_PROFILE=vump-dev

# Local Postgres, if running the database outside AWS. Ignored in Lambda,
# which resolves DATABASE_CREDENTIALS_SECRET_ARN instead.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vump_dev
