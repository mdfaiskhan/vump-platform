# Flutter build-time configuration — EXAMPLE
#
# Copy to .env.dev / .env.staging / .env.prod and pass at build time:
#
#   flutter run   --dart-define-from-file=.env.dev
#   flutter build appbundle --dart-define-from-file=.env.prod
#
# The real files are never committed (Volume 7, Chapter 7.10). Only this
# example lives in the repository.
#
# ---------------------------------------------------------------------------
# THIS FILE CONTAINS NO SECRETS, AND NEITHER DO THE FILES COPIED FROM IT.
# ---------------------------------------------------------------------------
#
# That is a deliberate property, not an accident of the current variable list.
# A Flutter binary is distributed to devices outside our control and can be
# decompiled, so anything compiled into it is public. ADR-016 therefore forbids
# a secret from ever appearing here.
#
# If you find yourself wanting to add an API key, a token, or a password to
# this file: stop. The value belongs behind the backend, reached with the
# user's Firebase ID token. See docs/development/secrets-management.md.


# Which environment this build targets.
#
# One of: development | staging | production
# Read by AppConfig (ADR-006). Everything else the app needs — API base URL,
# S3 bucket, timeouts — is derived from this value in code, per ADR-007 and
# ADR-011. That is why they are not listed here: one input, not four.
APP_ENV=development
