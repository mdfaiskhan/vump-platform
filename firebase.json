{
  "_comment": "Deployment config for the temporary invite-code runtime (ADR-036), retired at Mission 6/7. Separate from mobile/firebase.json, which flutterfire generates and owns.",
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"],
      "ignore": ["node_modules", ".git", "*.log"]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "functions": {"port": 5001},
    "firestore": {"port": 8080},
    "auth": {"port": 9099},
    "ui": {"enabled": true}
  }
}
