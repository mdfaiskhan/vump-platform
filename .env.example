# Repository tooling configuration — EXAMPLE
#
# Copy to .env for local infrastructure work. Never committed.
#
# This file configures the scripts under infrastructure/, not the application.
# Flutter reads mobile/.env.* and the backend reads backend/.env — each
# component has its own, because each has a different consumer and a
# different security posture.
#
# Contains no secret, and must never contain one.


# AWS CLI profile used by the scripts in infrastructure/aws/.
# A profile name, never a key. Credentials live in ~/.aws/credentials, which
# is outside this repository and outside anything git can see.
AWS_PROFILE=vump-admin

# All environments are in ap-south-1 (ADR-011).
AWS_REGION=ap-south-1
